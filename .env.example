# Model selection. Two accepted forms:
#   provider:model   direct, via the provider's own SDK (anthropic | openai | google)
#   provider/model   through the Vercel AI Gateway
MODEL=anthropic:claude-opus-5

# One of these, matching the provider in MODEL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Required only for the gateway form of MODEL.
# AI_GATEWAY_API_KEY=

# Optional: a separate model used to rate answers during `pnpm eval`.
# Without it the eval reports the structural score and skips the rating.
# JUDGE_MODEL=anthropic:claude-opus-5

# Optional: appended to the server's User-Agent when querying GBIF, so a
# high-volume operator can be contacted rather than simply blocked.
# GBIF_USER_AGENT_CONTACT=you@example.org

# Optional: point the agent at a different built server.
# GBIF_MCP_SERVER_PATH=/absolute/path/to/packages/mcp-server/dist/index.js

# Optional: server log level on stderr (trace|debug|info|warn|error|silent).
# LOG_LEVEL=info
