# Model selection. Two accepted forms:
#   provider:model   direct, via the provider's own SDK (anthropic | openai | google)
#   provider/model   through the Vercel AI Gateway
MODEL=anthropic:claude-opus-5

# One of these, matching the provider in MODEL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Required only for the gateway form of MODEL.
# AI_GATEWAY_API_KEY=

# Optional: a separate model used to rate answers during `pnpm eval`.
# Without it the eval reports the structural score and skips the rating.
# JUDGE_MODEL=anthropic:claude-opus-5

# Optional: export agent traces to VoltOps. Both keys are required — with only
# one set the agent says so on stderr and runs untraced.
# VOLTOPS_PUBLIC_KEY=pk_...
# VOLTOPS_SECRET_KEY=sk_...

# Optional: appended to the server's User-Agent when querying GBIF, so a
# high-volume operator can be contacted rather than simply blocked.
# GBIF_USER_AGENT_CONTACT=you@example.org

# Optional: the total budget (milliseconds) one tool call gets against GBIF,
# covering every attempt, retry and backoff wait — default 60000 (60s). Raise
# this if broad, unfiltered queries are hitting UPSTREAM_TIMEOUT before a full
# retry sequence can clear a slow response.
# GBIF_CALL_BUDGET_MS=60000

# Optional: point the agent at a different built server.
# GBIF_MCP_SERVER_PATH=/absolute/path/to/packages/mcp-server/dist/index.js

# Optional: server log level on stderr (trace|debug|info|warn|error|silent).
# Applies to the server however it is started: run directly, or launched by the
# CLI agent, which forwards this variable to the server it spawns. `debug` adds
# the upstream-shape diagnostic (which part of a GBIF response failed its
# schema) without changing anything a caller sees.
# LOG_LEVEL=info
